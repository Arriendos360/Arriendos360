# Servidor
PORT=

# Base de Datos PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=

# Enrutamiento del gateway
#
# URL base de cada microservicio extraido. Vacia = ese prefijo se resuelve con
# el codigo local del monolito; con valor = el gateway reenvia por HTTP.
#
# Hoy las cuatro estan vacias: todo resuelve local. Se llenan una por una a
# medida que avanza la migracion (pasos 3 a 6). Ejemplo cuando exista el
# servicio: MS_IDENTIDAD_URL=http://ms-identidad:3011
#
# /api/auth y /api/usuarios comparten MS_IDENTIDAD_URL: los dos son ms-identidad
# y se extraen juntos en el paso 3b.
#
# /api/dashboard y /api/admin no aparecen aqui: son siempre locales. El
# dashboard vive en el gateway por diseno y no tiene tablas propias.
MS_IDENTIDAD_URL=
MS_INMUEBLES_URL=
MS_CONTRATOS_URL=
MS_FINANCIERO_URL=

# Autenticacion entre servicios
#
# Los endpoints /interno no los llama una persona, los llama otro servicio. La
# credencial es un JWT de vida corta firmado con esta clave, que NO es la misma
# que JWT_SECRET: si lo fuera, el token de cualquier usuario serviria para
# llamar a /interno.
#
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser IDENTICA en todos los servicios.
SERVICIO_JWT_SECRET=

# Nombre de este servicio. Viaja como emisor al llamar y se exige como
# destinatario al recibir.
SERVICIO_NOMBRE=

# Bus de eventos — publicador
#
# Cada cuantos milisegundos el publicador barre la tabla de salida buscando
# eventos sin entregar. Por defecto 5000, y ese numero ES la ventana de
# consistencia esperada: el tiempo que puede pasar entre firmar un contrato y
# que el inmueble aparezca como arrendado. Bajarlo acorta la ventana y sube la
# carga sobre la base; subirlo, al reves.
#
# No hay que tocarlo para que funcione. Se expone porque en una demostracion en
# vivo puede convenir un barrido mas frecuente.
EVENTOS_INTERVALO_MS=

# Los suscriptores NO se configuran aparte: se leen de las MS_*_URL de arriba.
# Hoy `ContratoFormalizado` y `ContratoFinalizado` van a MS_INMUEBLES_URL, y en
# el paso 6 el primero gana un segundo destino en MS_FINANCIERO_URL.

# Almacenamiento de anexos
#
# La regla es una sola: si hay cadena de conexion de Azure se usa Azure Blob
# Storage; si no, el disco del propio proceso. Sin banderas que activar, para que
# no haya forma de desplegar creyendo que se guarda en Blob mientras los archivos
# van a un disco que se borra esa misma noche.
#
# En desarrollo y en las pruebas se deja VACIA. Ver docs/adr/0014.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTENEDOR=

# Raiz de la implementacion de disco. Por defecto `almacenamiento/`, relativa al
# directorio del gateway. NO es `uploads/`: aquel se servia con express.static y
# reutilizar el nombre invitaria a volver a exponerlo.
ALMACENAMIENTO_RUTA=
