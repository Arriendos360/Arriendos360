# Servidor
PORT=

# ── EL GATEWAY YA NO TIENE BASE DE DATOS ─────────────────────────────────────
#
# Aqui estaban DB_HOST, DB_PORT, DB_NAME, DB_USER y DB_PASSWORD. Se fueron en el
# paso 6e: `cuentas_cobro` y `transacciones` eran las dos ultimas tablas del
# gateway y se marcharon con ms-financiero, asi que este proceso ya NO ABRE UNA
# CONEXION A POSTGRESQL. Arranca sin base, que es lo que se espera de un Policy
# Enforcement Point.
#
# Si alguna de esas variables sigue en tu .env local, sobra.

# JWT de usuario. IDENTICO al de los cuatro servicios: todos verifican la misma
# firma.
JWT_SECRET=

# Enrutamiento del gateway
#
# URL base de cada microservicio. Vacia = ese prefijo se resolveria con codigo
# local del monolito; con valor = el gateway reenvia por HTTP.
#
# DESDE EL PASO 6e LAS CUATRO TIENEN QUE ESTAR PUESTAS. Ya no queda codigo local
# al que caer: los cinco prefijos de la API los sirven los servicios, y el unico
# que se resuelve aqui es /api/dashboard, que no tiene variable porque no tiene
# servicio propio (regla dura 5).
#
# /api/auth y /api/usuarios comparten MS_IDENTIDAD_URL: los dos son ms-identidad.
#
# Estas URL sirven ADEMAS para componer. El dashboard le pide a los tres las
# cifras que agrega, y `clientes/` las usa tambien para la pertenencia y para el
# guardia de borrado.
#
# Ejemplo: MS_IDENTIDAD_URL=http://ms-identidad:3011
MS_IDENTIDAD_URL=
MS_INMUEBLES_URL=
MS_CONTRATOS_URL=
MS_FINANCIERO_URL=

# Autenticacion entre servicios
#
# Los endpoints /interno no los llama una persona, los llama otro servicio. La
# credencial es un JWT de vida corta firmado con esta clave, que NO es la misma
# que JWT_SECRET: si lo fuera, el token de cualquier inquilino serviria para
# llamar a /interno. Ver docs/adr/0009.
#
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser IDENTICA en todos los servicios.
SERVICIO_JWT_SECRET=

# Nombre de este servicio. Viaja como emisor al llamar y se exige como
# destinatario al recibir.
SERVICIO_NOMBRE=

# Cada cuanto refresca el gateway su copia en memoria de los tokens revocados.
# Esa ventana es lo que tarda un logout en surtir efecto aqui. Ver docs/adr/0008.
REVOCADOS_INTERVALO_MS=

# Origen del cliente
#
# La limitacion de tasa la aplica ms-identidad, no el gateway (docs/adr/0020). Lo
# que pone el gateway es la IP del cliente, firmada en cada reenvio, y para
# resolverla necesita saber cuantos proxies tiene delante que sean de confianza.
#
# Vacia en local y en Compose, donde el cliente llega directo. 1 en Container Apps,
# que pone su ingreso delante. Mas de los reales deja que el cliente elija su IP con
# X-Forwarded-For; menos cuenta a todo el mundo bajo la IP del proxy.
PROXY_SALTOS_CONFIANZA=

# Cuanto espera el gateway a un servicio antes de responder 502. Por defecto 10000.
# En Azure 60000: un servicio escalado a cero tarda en despertar. Ver docs/adr/0022.
PROXY_TIMEOUT_MS=

# Origenes que pueden llamar a la API desde un navegador, separados por comas. Vacia en
# local = cualquiera. En Azure, el origen de la SPA en Static Web Apps.
CORS_ORIGENES=

# ── LO QUE TAMPOCO ES DEL GATEWAY ────────────────────────────────────────────
#
# Bus de eventos: la tabla de salida y el publicador se fueron con ms-contratos
# en el paso 6d. `EVENTOS_INTERVALO_MS` se configura alli.
#
# Almacenamiento de anexos: se fue con ms-contratos en el 6d.
# `AZURE_STORAGE_*` se configura alli.
#
# Correo: se fue con ms-financiero en el 6e junto con el motor. `EMAIL_*` se
# configura alli (y en ms-identidad, para la recuperacion de contrasena).
