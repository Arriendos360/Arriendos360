    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Buscar inquilino por documento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.id) { pm.collectionVariables.set(\"id_inquilino\", d.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios?documento=10000002",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ],
              "query": [
                {
                  "key": "documento",
                  "value": "10000002"
                }
              ]
            },
            "description": "Coincidencia exacta. Devuelve solo id, nombres y apellidos, y queda registrada en identidad.consultas_documento. La sirve ms-identidad; el gateway la reenvia."
          }
        },
        {
          "name": "Dar de alta un inquilino",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.usuario) { pm.collectionVariables.set(\"id_inquilino\", d.usuario.id); }",
                  "if (d.contrasena_temporal) { pm.collectionVariables.set(\"contrasena_temporal\", d.contrasena_temporal); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombres\": \"Maria\",\n    \"apellidos\": \"Gomez\",\n    \"email\": \"inquilino@test.com\",\n    \"telefono\": \"3009876543\",\n    \"documento\": \"987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/inquilinos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "inquilinos"
              ]
            },
            "description": "No se manda contrasena: la genera ms-identidad y la devuelve UNA vez en contrasena_temporal."
          }
        }
      ]
    },
