  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registro de Propietario",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombres\": \"Juan\",\n    \"apellidos\": \"Perez\",\n    \"email\": \"propietario@test.com\",\n    \"contrasena\": \"password123\",\n    \"telefono\": \"3001234567\",\n    \"documento\": \"123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "El contrato de interfaz del Capitulo 2 no lleva campo `rol`: el registro publico crea siempre PROPIETARIO."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set(\"token\", d.token); }",
                  "if (d.usuario) { pm.collectionVariables.set(\"id_usuario\", d.usuario.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"propietario@test.com\",\n    \"contrasena\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Logout (revoca el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Cuerpo vacio. Anota el `jti` del token en TokensRevocados hasta su expiracion natural. A partir de aqui el mismo token responde 401."
          }
        },
        {
          "name": "Cambiar contrasena",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set(\"token\", d.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"contrasena_actual\": \"{{contrasena_temporal}}\",\n    \"contrasena_nueva\": \"MiClaveNueva1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/cambiar-contrasena",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "cambiar-contrasena"
              ]
            },
            "description": "Unica ruta accesible con la contrasena temporal sin cambiar. Revoca el token en curso y emite otro. Ver docs/adr/0007."
          }
        }
      ]
