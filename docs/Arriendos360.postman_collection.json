{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a5b-bcde-1234567890ab",
    "name": "Arriendos360 API",
    "description": "Colección para probar todos los endpoints de la plataforma de gestión de arrendamientos.\n\nNota: El sistema incluye un MOTOR FINANCIERO automático que genera recibos (RF-14), envía alertas (RF-15) y calcula mora (RF-16) diariamente a la medianoche.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registro de Propietario",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombres\": \"Juan\",\n    \"apellidos\": \"Perez\",\n    \"email\": \"propietario@test.com\",\n    \"contrasena\": \"password123\",\n    \"telefono\": \"3001234567\",\n    \"documento\": \"123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "El contrato de interfaz del Capitulo 2 no lleva campo `rol`: el registro publico crea siempre PROPIETARIO."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set(\"token\", d.token); }",
                  "if (d.usuario) { pm.collectionVariables.set(\"id_usuario\", d.usuario.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"propietario@test.com\",\n    \"contrasena\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Logout (revoca el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Cuerpo vacio. Anota el `jti` del token en TokensRevocados hasta su expiracion natural. A partir de aqui el mismo token responde 401."
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Buscar inquilino por documento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.id) { pm.collectionVariables.set(\"id_inquilino\", d.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios?documento=10000002",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ],
              "query": [
                {
                  "key": "documento",
                  "value": "10000002"
                }
              ]
            },
            "description": "Coincidencia exacta. Devuelve solo id, nombres y apellidos, y queda registrada en identidad.consultas_documento. La sirve ms-identidad; el gateway la reenvia."
          }
        },
        {
          "name": "Dar de alta un inquilino",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.usuario) { pm.collectionVariables.set(\"id_inquilino\", d.usuario.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombres\": \"Maria\",\n    \"apellidos\": \"Gomez\",\n    \"email\": \"inquilino@test.com\",\n    \"contrasena\": \"password123\",\n    \"telefono\": \"3009876543\",\n    \"documento\": \"987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/inquilinos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "inquilinos"
              ]
            },
            "description": "Exige propietario autenticado. Crea el usuario con rol INQUILINO."
          }
        }
      ]
    },
