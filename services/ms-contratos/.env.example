# Servidor
PORT=

# Base de Datos PostgreSQL
# Misma instancia que el resto; el aislamiento es por ESQUEMA (`inmuebles`).
DB_HOST=
DB_PORT=
DB_NAME=
DB_NAME_TEST=
DB_USER=
DB_PASSWORD=

# JWT — debe ser IDENTICO al del gateway: los dos verifican la misma firma.
JWT_SECRET=

# Autenticacion entre servicios
#
# Los endpoints /interno no los llama una persona, los llama otro servicio. La
# credencial es un JWT de vida corta firmado con esta clave, que NO es la misma
# que JWT_SECRET: si lo fuera, el token de cualquier usuario serviria para
# llamar a /interno.
#
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser IDENTICA en todos los servicios.
SERVICIO_JWT_SECRET=

# Nombre de este servicio. Viaja como emisor al llamar y se exige como
# destinatario al recibir.
SERVICIO_NOMBRE=

# De donde saca la lista de tokens revocados y sesiones caidas.
#
# Este servicio revalida el token por su cuenta (regla dura 7) y eso incluye la
# revocacion, pero la tabla es de ms-identidad. Se pide por HTTP y se cachea en
# memoria; ver docs/adr/0008 para la ventana que implica.
#
# OBLIGATORIA: sin valor el servicio no arranca. Antes arrancaba sin comprobar la
# revocacion —un token de una sesion cerrada entraba— y solo lo avisaba en el log.
MS_IDENTIDAD_URL=

# Inmuebles: de aqui sale la pertenencia de cada contrato, y aqui van sus
# eventos. OBLIGATORIA al arrancar; las pruebas levantan su propio doble.
MS_INMUEBLES_URL=

# Financiero: consume ContratoFormalizado y crea la primera cuenta de cobro.
# OBLIGATORIA: sin ella el evento se daria por entregado sin que nadie facturara.
MS_FINANCIERO_URL=

# Cada cuantos milisegundos se refresca esa copia. Por defecto 15000.
REVOCADOS_INTERVALO_MS=

# Bus de eventos — publicador
#
# Cada cuantos milisegundos el publicador barre la tabla de salida buscando
# eventos sin entregar. Por defecto 5000, y ese numero ES la ventana de
# consistencia esperada: el tiempo que puede pasar entre firmar un contrato y
# que el inmueble aparezca como arrendado.
#
# Los suscriptores NO se configuran aparte: se leen de las MS_*_URL de arriba.
EVENTOS_INTERVALO_MS=

# Almacenamiento de anexos
#
# La regla es una sola: si hay cadena de conexion de Azure se usa Azure Blob
# Storage; si no, el disco del propio proceso. Sin banderas que activar, para que
# no haya forma de desplegar creyendo que se guarda en Blob mientras los archivos
# van a un disco que se borra esa misma noche.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTENEDOR=

# Migraciones. OBLIGATORIA: `si` en Compose y en local, donde el servicio migra al
# arrancar; `no` en Azure, donde las aplica un Job antes de publicar la revision y el
# servicio solo comprueba que no queden pendientes (si quedan, no arranca).
# Ver docs/adr/0022.
MIGRACIONES_AL_ARRANCAR=

# TLS hacia PostgreSQL, `si` o `no`. `si` en Azure, que lo exige; vacia = no.
DB_SSL=

# Conexiones maximas del pool por replica. Por defecto 5; en Azure 3.
DB_POOL_MAX=
