{
  "name": "arriendos360-ms-notificaciones",
  "version": "0.0.0",
  "private": true,
  "description": "MS-Notificaciones: consume eventos del bus y avisa a las personas. Sin endpoints publicos.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit --detectOpenHandles",
    "migrate": "ts-node src/database/aplicar.ts",
    "enviar": "ts-node src/scripts/enviar.ts"
  },
  "dependencies": {
    "arriendos360-shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "nodemailer": "^8.0.10",
    "pg": "^8.10.0",
    "sequelize": "^6.31.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
