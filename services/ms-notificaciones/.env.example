# Servidor
PORT=3015

# Base de Datos PostgreSQL
#
# Comparte instancia con el resto del sistema, pero NO esquema: las dos tablas de
# este servicio viven en `notificaciones` y el `search_path` lo fija el codigo.
# Ninguna de las dos es de dominio: la bitacora de eventos procesados y la de
# envios.
DB_HOST=
DB_PORT=
DB_NAME=
DB_NAME_TEST=
DB_USER=
DB_PASSWORD=

# ── SIN JWT_SECRET, Y ESO ES CORRECTO ──────────────────────────────────────────
#
# Este servicio NO tiene endpoints publicos: no aparece en la costura del gateway
# ni tiene filas en la matriz RBAC. Nunca le llega un token de usuario, asi que no
# hay nada que revalidar y la regla dura 7 se cumple por vacio.
#
# Tampoco necesita MS_IDENTIDAD_URL para la revocacion, por lo mismo. La necesita
# para OTRA cosa: resolver a que direccion se avisa. Ver abajo.

# Autenticacion ENTRE servicios, para /interno. Es la UNICA credencial que este
# servicio maneja, en las dos direcciones: la exige en `POST /interno/eventos` y
# la firma al preguntar por un destinatario. Ver docs/adr/0009.
SERVICIO_JWT_SECRET=
SERVICIO_NOMBRE=ms-notificaciones

# A quien pregunta este servicio: SOLO a ms-identidad, y solo para una cosa —
# resolver el correo de un `id_usuario`. Los eventos no llevan direcciones de
# correo a proposito, y esta es la variable que lo hace posible. Sin ella el
# servicio arranca pero NO puede notificar a nadie, y lo grita en el log.
MS_IDENTIDAD_URL=

# Base publica de la SPA. La usa la plantilla del correo de recuperacion para
# construir el enlace: el evento lleva el token, no la URL, porque armar el enlace
# es cosa del canal.
URL_APP=

# Correo. Sin EMAIL_USER apunta a un buzon de pruebas (Ethereal) y no llega a
# nadie de verdad; para ver el mensaje hay que leer la URL de vista previa del
# log, o consultar `notificaciones.envios`.
#
# A DIFERENCIA de los dos mailers que este servicio sustituye, aqui esto NO es
# provisional: es el sitio que el Capitulo 2 le asigna al canal.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_REMITENTE=

# Cada cuanto barre el enviador la bitacora de envios pendientes.
ENVIOS_INTERVALO_MS=
