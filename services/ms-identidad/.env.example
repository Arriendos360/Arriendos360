# Servidor
PORT=

# Base de Datos PostgreSQL
# Misma instancia que el resto; el aislamiento es por ESQUEMA (`identidad`).
DB_HOST=
DB_PORT=
DB_NAME=
DB_NAME_TEST=
DB_USER=
DB_PASSWORD=

# JWT — debe ser IDENTICO al del gateway: los dos verifican la misma firma.
JWT_SECRET=

# Autenticacion entre servicios
#
# Los endpoints /interno no los llama una persona, los llama otro servicio. La
# credencial es un JWT de vida corta firmado con esta clave, que NO es la misma
# que JWT_SECRET: si lo fuera, el token de cualquier usuario serviria para
# llamar a /interno.
#
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser IDENTICA en todos los servicios.
SERVICIO_JWT_SECRET=

# Nombre de este servicio. Viaja como emisor al llamar y se exige como
# destinatario al recibir.
SERVICIO_NOMBRE=


# ── DESDE EL PASO 7 ESTE SERVICIO PUBLICA EN EL BUS ──────────────────────────
#
# Ya no manda correos: anota RecuperacionSolicitada y ContrasenaTemporalEmitida en
# identidad.eventos_salida y es ms-notificaciones quien avisa. Con eso se salda la
# desviacion del ADR 0010.
#
# A quien se le entregan esos eventos. OJO: SIN ESTA VARIABLE los eventos se dan
# por entregados sin que nadie los reciba, asi que NO sale ningun correo —ni el
# enlace de recuperacion de contrasena— y no hay ningun error que lo delate. El
# arranque lo avisa en el log.
MS_NOTIFICACIONES_URL=

# Cada cuanto barre el publicador su tabla de salida. Ese numero es la ventana
# entre pedir recuperacion y que el correo salga.
EVENTOS_INTERVALO_MS=

# ── Y YA NO NECESITA NADA DE CORREO ──────────────────────────────────────────
#
# URL_APP estaba aqui, para armar el enlace de recuperacion. Se fue con el
# Notificador: vive ahora en services/ms-notificaciones/.env.example, junto a las
# EMAIL_* que este servicio leia del entorno sin declararlas. Armar el enlace es
# cosa del canal, y el canal ya no es asunto de ms-identidad.

# Migraciones. OBLIGATORIA: `si` en Compose y en local, donde el servicio migra al
# arrancar; `no` en Azure, donde las aplica un Job antes de publicar la revision y el
# servicio solo comprueba que no queden pendientes (si quedan, no arranca).
# Ver docs/adr/0022.
MIGRACIONES_AL_ARRANCAR=

# TLS hacia PostgreSQL, `si` o `no`. `si` en Azure, que lo exige; vacia = no.
DB_SSL=

# Conexiones maximas del pool por replica. Por defecto 5; en Azure 3.
DB_POOL_MAX=
