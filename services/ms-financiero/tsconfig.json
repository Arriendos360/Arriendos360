{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // `allowJs` esta aqui por UN archivo: `services/pdfService.js`, que se mudo
    // desde el gateway sin tocar ni una linea porque el requisito del paso 6e es
    // que los comprobantes impriman exactamente lo mismo que antes. Sin esto,
    // `tsc` no lo copiaria a `dist/` y `npm start` se caeria al importarlo.
    //
    // `checkJs` queda APAGADO a proposito: el objetivo es emitirlo, no
    // comprobarlo. Sus tipos los pone `services/pdfService.d.ts`, que TypeScript
    // resuelve antes que el `.js`. Ver `docs/adr/0018`.
    //
    // No es una puerta abierta a escribir JavaScript nuevo aqui: el resto del
    // servicio es TypeScript `strict`, y `pdfService.js` es el unico `.js`.
    "allowJs": true,
    "checkJs": false,

    // Un servicio no se consume como libreria: no emite .d.ts.
    "declaration": false,
    "sourceMap": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
