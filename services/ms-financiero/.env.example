# Servidor
PORT=3014

# Base de Datos PostgreSQL
#
# Comparte instancia con el resto del sistema, pero NO esquema: las tablas de
# este servicio viven en `financiero` y el `search_path` lo fija el codigo.
DB_HOST=
DB_PORT=
DB_NAME=
DB_NAME_TEST=
DB_USER=
DB_PASSWORD=

# JWT de usuario. IDENTICO al del gateway y al de los demas servicios: todos
# verifican la misma firma. Confianza cero (regla dura 7): este servicio revalida
# el token aunque venga del gateway.
JWT_SECRET=

# Autenticacion ENTRE servicios, para /interno. NO es la misma clave que
# JWT_SECRET: si lo fuera, el token de cualquier inquilino serviria para llamar a
# /interno y facturar canones ajenos. Ver docs/adr/0009.
SERVICIO_JWT_SECRET=
SERVICIO_NOMBRE=ms-financiero

# A quien pregunta este servicio.
#
# Contratos: la pertenencia de cada cuenta de cobro y los datos que imprimen los
# comprobantes. El inmueble viaja DENTRO del contrato (`incluir=inmueble`), asi
# que este servicio no habla con ms-inmuebles.
MS_CONTRATOS_URL=
# Identidad: la lista de revocados y los correos a los que avisa el motor. Sin
# esto el servicio arranca pero NO comprueba revocacion, y lo avisa en el log.
MS_IDENTIDAD_URL=

# Cada cuanto se refresca la copia en memoria de los tokens revocados.
REVOCADOS_INTERVALO_MS=

# ── DESDE EL PASO 7 ESTE SERVICIO PUBLICA EN EL BUS ──────────────────────────
#
# Aqui estaban EMAIL_HOST, EMAIL_PORT, EMAIL_USER y EMAIL_PASS, con una nota que
# decia: «en el paso 7 esto desaparece de aqui, el motor pasara a publicar eventos y
# sera ms-notificaciones quien mande los correos». Eso es lo que ha pasado.
#
# A quien se le entregan esos eventos —CuentaCobroGenerada, CuentaCobroPorVencer y
# CuentaCobroEnMora—. OJO: SIN ESTA VARIABLE se dan por entregados sin que nadie los
# reciba, asi que el motor factura y marca moras pero NO sale ningun correo, y no hay
# ningun error que lo delate. El arranque lo avisa en el log.
MS_NOTIFICACIONES_URL=

# Cada cuanto barre el publicador su tabla de salida.
EVENTOS_INTERVALO_MS=

# Programacion del motor de facturacion y mora. OBLIGATORIA y sin valor por defecto,
# para que la diferencia entre entornos este escrita y no se deduzca:
#
#   cron     node-cron dentro de este proceso, a las 00:01 de Bogota. Compose y local.
#   trabajo  este proceso NO programa nada: lo ejecuta el Job programado de Container
#            Apps `motor-financiero` (infra/azure/apps.bicep) con `node dist/scripts/motor.js`.
#
# Con scale-to-zero un cron dentro del contenedor no dispara. Ver docs/adr/0021.
MOTOR_PROGRAMACION=

# Migraciones. OBLIGATORIA: `si` en Compose y en local, donde el servicio migra al
# arrancar; `no` en Azure, donde las aplica un Job antes de publicar la revision y el
# servicio solo comprueba que no queden pendientes (si quedan, no arranca).
# Ver docs/adr/0022.
MIGRACIONES_AL_ARRANCAR=

# TLS hacia PostgreSQL, `si` o `no`. `si` en Azure, que lo exige; vacia = no.
DB_SSL=

# Conexiones maximas del pool por replica. Por defecto 5; en Azure 3.
DB_POOL_MAX=
