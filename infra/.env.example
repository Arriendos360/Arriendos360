# Interpolacion de docker-compose. Debe estar en infra/ (directorio de proyecto
# de Compose cuando se usa -f infra/docker-compose.yml). NO se versiona.
# Estos dos valores deben coincidir con los de apps/gateway/.env
DB_PASSWORD=
JWT_SECRET=

# Autenticacion entre servicios. Identica para todos; el nombre de cada uno lo
# fija docker-compose.yml, no este archivo.
SERVICIO_JWT_SECRET=

# URL de los servicios. docker-compose.yml les pone valor por defecto
# (`${VAR:-http://ms-...}`), asi que vacias apuntan a los contenedores de Compose;
# solo hacen falta para apuntar a otro sitio. Sirven ADEMAS como lista de
# suscriptores del bus: MS_FINANCIERO_URL la lee tambien ms-contratos para
# entregarle `ContratoFormalizado`.
MS_IDENTIDAD_URL=
MS_INMUEBLES_URL=
MS_CONTRATOS_URL=
MS_FINANCIERO_URL=
MS_NOTIFICACIONES_URL=

# Correo (ms-notificaciones). Sin EMAIL_USER el correo no sale: va al log del
# servicio, que es donde se lee el enlace de recuperacion en desarrollo.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_REMITENTE=
# Base de los enlaces de los correos (la SPA).
URL_APP=

# Anexos (ms-contratos). Sin cadena de conexion se guardan en disco.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTENEDOR=

# Intervalos del publicador del bus y del enviador de correos, en ms.
EVENTOS_INTERVALO_MS=
ENVIOS_INTERVALO_MS=
