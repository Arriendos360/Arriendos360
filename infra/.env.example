# Interpolacion de docker-compose. Debe estar en infra/ (directorio de proyecto
# de Compose cuando se usa -f infra/docker-compose.yml). NO se versiona.
# Estos dos valores deben coincidir con los de apps/gateway/.env
DB_PASSWORD=
JWT_SECRET=

# Enrutamiento del gateway. Desde el paso 6e los cuatro servicios existen y
# docker-compose.yml les pone valor por defecto, asi que estas solo hacen falta
# para apuntar a otro sitio. Sirven ADEMAS como lista de suscriptores del bus:
# MS_FINANCIERO_URL la lee tambien ms-contratos para entregarle
# `ContratoFormalizado`.
MS_IDENTIDAD_URL=
MS_INMUEBLES_URL=
MS_CONTRATOS_URL=http://ms-contratos:3013
MS_FINANCIERO_URL=

# Autenticacion entre servicios. Identica para todos; el nombre de cada uno lo
# fija docker-compose.yml, no este archivo.
SERVICIO_JWT_SECRET=
