{
  "name": "arriendos360",
  "version": "1.0.0",
  "private": true,
  "description": "Arriendos360 - monorepo (apps, services, packages) para la migracion del monolito a microservicios",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build:packages": "npm run build --workspace=packages/contracts --workspace=packages/shared",
    "typecheck": "npm run typecheck --workspace=packages/contracts --workspace=packages/shared --workspace=services/ms-identidad"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.3"
  }
}
